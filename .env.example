APP_NAME=ThesisCheck
APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite:///./data/thesischeck.db
MAX_UPLOAD_MB=30
INSPECTION_RATE_LIMIT=20
INSPECTION_RATE_WINDOW_SECONDS=60
PARSER_WORKER_TIMEOUT_SECONDS=35
PARSER_WORKER_CPU_SECONDS=25
PARSER_WORKER_MEMORY_MB=1024
PARSER_WORKER_CONCURRENCY=2
FILE_RETENTION_DAYS=7
LLM_MODE=off
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS_PER_JOB=12000
JWT_SECRET=replace-this-with-a-long-random-secret-before-any-deployment
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
